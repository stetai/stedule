{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "fs:allow-write-text-file",
    "dialog:default",
    "dialog:allow-save",
    "notification-scheduler:allow-schedule-notification",
    "notification-scheduler:allow-cancel-notification",
    "notification-scheduler:allow-request-notification-permission",
    "store:default",
    "store:allow-load"
  ]
}